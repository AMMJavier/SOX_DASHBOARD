# =====================================================================
# Plantilla de configuración. Copiar a backend/.env y completar.
# backend/.env NUNCA se sube a git (está en .gitignore).
# =====================================================================

# --- Oracle (autenticación y SOX) ---
ORACLE_USER=REEMPLAZAR
ORACLE_PASSWORD=REEMPLAZAR
ORACLE_HOST=SERVIDOR
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=SERVICIO

# --- PostgreSQL (módulo Assets) ---
# Opción A: URL completa
# ASSETS_DATABASE_URL=postgresql+psycopg2://usuario:clave@servidor:5432/base
# Opción B: por partes
POSTGRES_HOST=SERVIDOR
POSTGRES_PORT=5432
POSTGRES_DB=REEMPLAZAR
POSTGRES_USER=REEMPLAZAR
POSTGRES_PASSWORD=REEMPLAZAR
POSTGRES_SCHEMA=autom
# POSTGRES_SSLMODE=require

# --- LDAP / Active Directory ---
LDAP_SERVER=REEMPLAZAR
LDAP_BASE_DN=REEMPLAZAR
LDAP_SERVICE_USER=REEMPLAZAR
LDAP_SERVICE_PASSWORD=REEMPLAZAR
LDAP_STARTTLS=true

# --- JWT ---
JWT_SECRET_KEY=REEMPLAZAR
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Evidencia ---
SOX_EVIDENCE_DIR=REEMPLAZAR

# --- Control 6 - Consulta LDAP ---
LDAP6_SERVER=REEMPLAZAR
LDAP6_MODE=REEMPLAZAR
LDAP6_ALLOW_UNVERIFIED_TLS=false
LDAP6_PAGE_SIZE=500
