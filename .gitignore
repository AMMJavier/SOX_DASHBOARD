# =====================================================================
#  SOX Dashboard - .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. SECRETOS Y CONFIGURACIÓN CON CREDENCIALES  (NUNCA SUBIR)
# ---------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# Configs reales (se suben solo las plantillas *.example.json)
backend/config/*.json
!backend/config/*.example.json

# Llaves, certificados y wallets (Oracle, TLS, etc.)
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
wallet/
Wallet_*/
tnsnames.ora
sqlnet.ora
cwallet.sso
ewallet.p12

# Scripts de prueba con credenciales/IPs internas hardcodeadas
backend/auth/test_ldap.py
backend/database/test_insert.py
exportar_vpn_ldap.py

# ---------------------------------------------------------------------
# 2. DATOS CONFIDENCIALES (usuarios, VPN, LDAP, evidencias, exports)
# ---------------------------------------------------------------------
db.json
*.csv
*.xlsx
*.xls
vpn_export.json
**/checkpoint/output/
backend/model_files/
evidencias/
uploads/
*.sqlite
*.sqlite3
*.db
*.dump
*.dmp

# ---------------------------------------------------------------------
# 3. RESPALDOS, DESPLIEGUES Y ARCHIVOS TEMPORALES
# ---------------------------------------------------------------------
backups/
despliegue_*/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.bak
*.bak_*
*.bak*
*.orig
*.old
*.tmp
dependencias_backend_anterior.txt

# ---------------------------------------------------------------------
# 4. PYTHON
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# ---------------------------------------------------------------------
# 5. NODE / FRONTEND
# ---------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
frontend/dist*/
*.local
.vite/

# ---------------------------------------------------------------------
# 6. LOGS
# ---------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
nohup.out

# ---------------------------------------------------------------------
# 7. EDITORES Y SISTEMA OPERATIVO
# ---------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
